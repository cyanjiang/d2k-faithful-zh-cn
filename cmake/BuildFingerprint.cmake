# Writes the build fingerprint header for network games (docs/design/multiplayer.md
# section 6.3, "Version check"): a hash of every source file under SRC_DIR
# (line endings normalised, so a CRLF and an LF checkout agree) and the
# compiler. Two games join each other only when it matches, so builds that
# could simulate differently never meet in a lockstep game.
# Run as: cmake -DSRC_DIR=... -DOUT=... -DCOMPILER=... -P BuildFingerprint.cmake
file(GLOB_RECURSE srcs "${SRC_DIR}/*.cpp" "${SRC_DIR}/*.hpp" "${SRC_DIR}/*.h")
list(SORT srcs)
set(all "")
foreach(f IN LISTS srcs)
    file(READ "${f}" text)
    string(REPLACE "\r\n" "\n" text "${text}")
    string(SHA256 h "${text}")
    file(RELATIVE_PATH r "${SRC_DIR}" "${f}")
    string(APPEND all "${r} ${h}\n")
endforeach()
string(APPEND all "${COMPILER}\n")
string(SHA256 fp "${all}")
string(SUBSTRING "${fp}" 0 16 fp)
set(content "#pragma once\n// Generated by cmake/BuildFingerprint.cmake.\n#define D2K_BUILD_FINGERPRINT \"${fp}\"\n")
set(old "")
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL content) # unchanged: no rebuild of its users
    file(WRITE "${OUT}" "${content}")
endif()
